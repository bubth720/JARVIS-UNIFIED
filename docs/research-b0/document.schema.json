{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jarvis:research-b0-document:1",
  "description": "Proposed isolated laboratory metadata only; no production schema modification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "document_id",
    "source_id",
    "origin_url",
    "final_url",
    "retrieved_at",
    "date_kind",
    "content_type",
    "size_bytes",
    "sha256",
    "validation",
    "transformations"
  ],
  "properties": {
    "format": {
      "const": "jarvis.research-b0-document/1"
    },
    "document_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,39}$"
    },
    "origin_url": {
      "type": "string",
      "maxLength": 2048
    },
    "final_url": {
      "type": "string",
      "maxLength": 2048
    },
    "retrieved_at": {
      "const": "2030-01-01T00:00:00Z"
    },
    "date_kind": {
      "const": "SIMULATED"
    },
    "content_type": {
      "enum": [
        "text/plain",
        "application/octet-stream"
      ]
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4194304
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "validation": {
      "const": "VERIFIED_SYNTHETIC"
    },
    "transformations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "tool",
          "input_sha256",
          "output_sha256"
        ],
        "properties": {
          "operation": {
            "const": "identity-stream-copy"
          },
          "tool": {
            "const": "research-b0/1"
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "output_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
