{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jarvis:integration-lock:1",
  "title": "integration-lock",
  "type": "object",
  "properties": {
    "format": {
      "const": "jarvis.integration-lock/1"
    },
    "mission": {
      "const": "FUSION-01/F0"
    },
    "composition": {
      "const": "CANDIDATE_NOT_INTEGRATED"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "core",
              "llm",
              "voice",
              "interface",
              "nexus",
              "services",
              "evolution",
              "unified"
            ]
          },
          "repository": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "primary": {
            "type": "object",
            "properties": {
              "branch": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$"
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$",
                "minLength": 40,
                "maxLength": 40
              },
              "parents": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$",
                  "minLength": 40,
                  "maxLength": 40
                },
                "minItems": 0,
                "maxItems": 4,
                "uniqueItems": true
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300,
                      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$",
                      "minLength": 64,
                      "maxLength": 64
                    }
                  },
                  "required": [
                    "path",
                    "sha256"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 40,
                "uniqueItems": true
              }
            },
            "required": [
              "branch",
              "commit",
              "parents",
              "files"
            ],
            "additionalProperties": false
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "branch": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                },
                "commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$",
                  "minLength": 40,
                  "maxLength": 40
                },
                "parents": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$",
                    "minLength": 40,
                    "maxLength": 40
                  },
                  "minItems": 0,
                  "maxItems": 4,
                  "uniqueItems": true
                },
                "files": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300,
                        "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$",
                        "minLength": 64,
                        "maxLength": 64
                      }
                    },
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1,
                  "maxItems": 40,
                  "uniqueItems": true
                }
              },
              "required": [
                "branch",
                "commit",
                "parents",
                "files"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 12,
            "uniqueItems": true
          },
          "ci": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "success",
                  "failure",
                  "pending",
                  "unknown",
                  "not_checked"
                ]
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$",
                "minLength": 40,
                "maxLength": 40
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$"
              }
            },
            "required": [
              "status",
              "commit",
              "url",
              "reason"
            ],
            "additionalProperties": false
          },
          "license": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "IDENTIFIED",
                  "UNKNOWN"
                ]
              },
              "expression": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$"
              },
              "basis": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$"
              }
            },
            "required": [
              "status",
              "expression",
              "basis"
            ],
            "additionalProperties": false
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "target": {
                  "type": "string",
                  "enum": [
                    "android24",
                    "android25",
                    "android26",
                    "android29_arm64",
                    "linux"
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "SUPPORTED",
                    "BLOCKED",
                    "NOT_TESTED"
                  ]
                },
                "basis": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                }
              },
              "required": [
                "target",
                "status",
                "basis"
              ],
              "additionalProperties": false
            },
            "minItems": 5,
            "maxItems": 5,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "repository",
          "owner",
          "primary",
          "alternatives",
          "ci",
          "license",
          "platforms"
        ],
        "additionalProperties": false
      },
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "components": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "required_action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "F1",
                "F2",
                "F3",
                "F4",
                "F5",
                "F6",
                "F7",
                "F8"
              ]
            },
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "components",
          "reason",
          "required_action",
          "blocks"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 30,
      "uniqueItems": true
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "F0",
              "F1",
              "F2",
              "F3",
              "F4",
              "F5",
              "F6",
              "F7",
              "F8"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 3,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            "minItems": 0,
            "maxItems": 8,
            "uniqueItems": true
          },
          "status": {
            "type": "string",
            "enum": [
              "VERIFIED",
              "PARTIAL",
              "BLOCKED",
              "NOT_RUN",
              "UNKNOWN"
            ]
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            "minItems": 0,
            "maxItems": 32,
            "uniqueItems": true
          },
          "basis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          }
        },
        "required": [
          "id",
          "depends_on",
          "status",
          "blockers",
          "basis"
        ],
        "additionalProperties": false
      },
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true
    },
    "frozen_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true
    }
  },
  "required": [
    "format",
    "mission",
    "composition",
    "observed_at",
    "components",
    "conflicts",
    "gates",
    "frozen_contracts"
  ],
  "additionalProperties": false
}
